# Copy to .env.local for local overrides. Never commit real values.

# Public URL of the deployed site, no trailing slash. Used for canonical URLs,
# sitemap.xml and robots.txt. Read at BUILD time (static export), so set it in the
# Cloudflare build variables too. Defaults to https://smietz-beauty-hub.workers.dev
# NEXT_PUBLIC_SITE_URL=https://www.example.com
